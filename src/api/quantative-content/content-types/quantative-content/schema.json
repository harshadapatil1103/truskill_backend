{
  "kind": "collectionType",
  "collectionName": "quantative_contents",
  "info": {
    "singularName": "quantative-content",
    "pluralName": "quantative-contents",
    "displayName": "Quantative Content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "topic": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quantative-topic.quantative-topic"
    },
    "contents_contents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quantative-content-content.quantative-content-content"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Overview",
        "Content",
        "Formula",
        "Exam Relevance",
        "FAQ"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "overview": {
      "type": "component",
      "repeatable": false,
      "component": "elements.overview"
    },
    "formula": {
      "type": "component",
      "repeatable": false,
      "component": "elements.formula"
    },
    "exam_relevance": {
      "type": "component",
      "repeatable": false,
      "component": "elements.exam-relevance"
    },
    "company_specific": {
      "type": "component",
      "repeatable": false,
      "component": "elements.company-specific"
    }
  }
}
